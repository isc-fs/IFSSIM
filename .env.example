# Copy to .env and adjust as needed

# Simulator host
# Mac/Windows: host.docker.internal (default, no change needed)
# Linux:       127.0.0.1 (host-gateway handles it via extra_hosts)
IFSSIM_HOST=host.docker.internal
IFSSIM_PORT=41451

# Mission configuration
MISSION_NAME=trackdrive
TRACK_NAME=A

# ROS2 domain (change if multiple stacks run on the same network)
ROS_DOMAIN_ID=0

# Set to true to start the full autonomous pipeline (slam, path_planning, control)
# false = bridge only (use for manual driving / topic verification)
PIPELINE_ENABLED=false

# Absolute path to Content/tracks on the HOST machine (used by backend to tell UE5 where to load tracks from)
# Default: auto-detected via ${PWD}/Content/tracks when running docker compose from the repo root
# Override only if you run docker compose from a different directory
# UE5_TRACKS_DIR=/absolute/path/to/IFSSIM/Content/tracks
