# UE5 build artifacts
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/

# Plugin build artifacts
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Dead vendored library — pre-FSocket FSDSPlugin used rpclib for the RPC
# server, but the current implementation is built on UE's FSocket /
# TcpListener (see Plugins/FSDSPlugin/Source/FSDSPlugin/Private/RPC/
# FSDSRpcServer.cpp). The Build.cs no longer references rpclib and no
# source file #includes from it. Older clones may still have a 14 MB
# ThirdParty/rpclib/ checkout on disk — keep git from picking it up.
Plugins/FSDSPlugin/ThirdParty/

# IDE files
.vs/
.vsconfig
*.sln
*.vcxproj*
.vscode/

# Xcode / Mac project files (generated by GenerateProjectFiles.sh)
*.xcworkspace/
*.xcodeproj/

# Python virtual environments
.venv/
venv/
__pycache__/
*.pyc

# Frontend build / dev-server caches (Mission Control is Vite)
node_modules/
.vite/
dist/

# OS files
.DS_Store
Thumbs.db

# Compiled content
*.BI
*.BI2

# ROS2 workspace build artifacts
ros2/build/
ros2/install/
ros2/log/

# Binary content assets tracked via Git LFS (*.uasset, *.umap)
.env

# Claude internal files
.claude/

# Packaged builds
Packaged/

# Generated track files and runtime state
Content/tracks/*.csv
Content/tracks/.ifssim_state.json

# UE5 editor scratch — *_BuiltData.uasset is regenerated lighting / nav
# data the editor saves alongside its .umap. We don't track it (its
# sibling .umap content already has all the source authoring info), so
# it just sits in everyone's `git status` after launching the editor.
*_BuiltData.uasset

# Documents (not source)
*.pdf

# Recorded ROS2 bags — large binary sqlite DBs, not source
tools/bags/
