// FSDS GPU LiDAR — depth-to-points decode (#223 Phase 3, #255 intensity).
//
// One thread per LiDAR ray (NumChannels × NumHorizontalSteps total).
// Each thread:
//   1. Computes its spherical (h, v) angles from its ray index.
//   2. Maps spherical → image plane via the same formulas the C++
//      round-trip test validates (tan(h), tan(v_cam) * sec(h),
//      v_cam = v - tilt).
//   3. Samples the depth, base-colour, and world-space normal RTs at
//      the corresponding texel.
//   4. Applies dropout / range noise / min-range cull (matches the
//      legacy CPU path's noise model so the dual-path validation in
//      Phase 4 can compare like-for-like).
//   5. Computes the Hesai-class intensity:
//        intensity = ρ_905 × cos(θ_inc) × (R_ref / range)²
//      with ρ_905 ≈ luminance(BaseColor) as a placeholder until per-
//      material 905 nm reflectance is tuned (#255 follow-up content task).
//   6. Reconstructs the 3D point in vehicle frame, applies the ROS
//      REP-103 Y-flip, and writes to the output structured buffer.
//
// Output buffer is float4[NumRays] where xyz is the point in metres
// (vehicle frame, ROS REP-103: x forward, y left, z up) and w is the
// intensity in [0, 1] for valid hits or -1.0 for no-hit/dropped/culled.

#include "/Engine/Public/Platform.ush"

Texture2D<float>  DepthTexture;
Texture2D<float4> ColorTexture;  // SCS_FinalColorLDR — luminance is the reflectance proxy
RWStructuredBuffer<float4> OutPoints;

uint  NumChannels;
uint  NumHorizontalSteps;
uint  RTWidth;
uint  RTHeight;

float HorizontalFOVStartRad;  // = HorizontalFOVStart * π/180
float HorizontalFOVEndRad;
float VerticalFOVUpperRad;
float VerticalFOVLowerRad;
float TiltRad;                // V-FOV centre (camera pitch in vehicle frame)

float HHalfPlanar;            // = tan(HFOV/2)
float VBottomPlanar;          // image-plane Y at frustum bottom (negative)
float VTopPlanar;             // image-plane Y at frustum top (positive)

float MinRangeCm;             // discard hits closer than this
float MaxRangeCm;             // far-plane sentinel (depths >= this = no hit)
StructuredBuffer<float> ChannelMaxRangeCm;  // per-channel max-range, NumberOfChannels entries
StructuredBuffer<float> ChannelElevationRad; // per-channel elevation (rad, sensor frame), NumberOfChannels entries

float RangeNoiseStdCm;        // σ at 0 m for ρ = RangeNoiseRefReflectance; 0 = no noise
float RangeNoiseRangeCoeffCm; // σ grows by this · range_m² (cm)
float RangeNoiseRefReflectance; // ρ at which the reflectance factor is 1
float RangeNoiseReflectanceExp; // σ ∝ (ρ_ref/ρ)^exp; 0 = off
float EdgeOutlierRate;        // probability of a mixed return at a >30 cm depth edge
float IntensityNoiseRel;      // relative σ of scan-to-scan intensity jitter
float DropoutRate;            // [0, 1]; 0 = no dropout

uint  RNGSeed;                // re-seeded each scan from CPU side

// Sensor mount offset in vehicle-frame METRES. The compute reconstructs
// the hit point relative to the sensor mount; adding this offset puts
// the output in vehicle-local frame, matching the CPU path which gets
// it implicitly via OwnerTransform.InverseTransformPosition.
float SensorOffsetXm;
float SensorOffsetYm;
float SensorOffsetZm;

// Sensor world-frame rotation (rows of the matrix) — used to take the
// vehicle-local ray direction into world frame so it can dot against
// the world-space surface normal stored in NormalTexture. Computed
// CPU-side from the sensor's actor rotation each scan.
float3 SensorRotRowX;
float3 SensorRotRowY;
float3 SensorRotRowZ;

// Mount rotation, sensor frame -> vehicle frame. The capture camera is
// rotated with the sensor, so (h, v), the texel lookup and the depth-to-
// range conversion all stay in the sensor frame; only the reconstructed
// point is rotated into the vehicle frame. Identity for a level mount.
float3 MountRotRowX;
float3 MountRotRowY;
float3 MountRotRowZ;

// Inverse-square reference range (m). Perpendicular surfaces at this
// range return the unmodified reflectance — i.e. intensity = ρ_905.
// Set CPU-side from a const so a single edit re-tunes the gain across
// the whole sensor.
float RReferenceM;

// Per-cone-material 905 nm reflectance lookup table (#321 D-Phase-1
// foundation, D-Phase-2 will fill in the post-process material that
// makes the alpha channel carry the stencil ID). Indexed by the stencil
// value the cone spawner writes into each cone mesh's
// CustomDepthStencilValue. Index 0 is reserved for "not a tagged cone"
// — anything in slot 0 OR any slot whose entry is <= 0 falls back to
// the Rec.709-luminance placeholder of the rendered colour.
//
// CPU side fills slots 1-4 from FSDSConeStencil::{Blue,Yellow,
// OrangeLarge,OrangeSmall} with datasheet ρ_905 values:
//   Blue ≈ 0.15, Yellow ≈ 0.50, Orange ≈ 0.65, white-stripe ≈ 0.92.
// Capped at 16 entries (uint8 stencil → 8-bit alpha encoding; we want
// generous headroom in 0-15 for new cone types without losing the
// non-cone discrimination range).
//
// DECLARE_SCALAR_ARRAY — UE5 packs scalar arrays 4-per-float4 in the
// constant buffer; we read individual elements via the
// GET_SCALAR_ARRAY_ELEMENT macro from Platform.ush.
DECLARE_SCALAR_ARRAY(float, ReflectanceLUT, 16);

// 0 = pre-Phase-2: ignore the LUT entirely, use Rec.709 luminance for
//     every hit. Default until the post-process material asset
//     (M_LiDARStencilEncoder, see follow-up issue) ships.
// 1 = LUT-on: decode stencil ID from the alpha channel of the
//     ColorTexture sample, look up ρ in ReflectanceLUT[], fall back to
//     luminance for slot-0 / out-of-range / zero-entry hits.
// Branching on a uniform is essentially free on GPU — the path the
// shader takes is constant across the whole dispatch.
uint UseReflectanceLUT;


// Single-step PCG hash. Cheap, decent statistical quality, and
// trivially deterministic per-ray-per-scan via (RayIdx ^ Seed).
// Reference: https://www.pcg-random.org/.
uint pcg_hash(uint x)
{
	x = x * 747796405u + 2891336453u;
	x = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
	return (x >> 22u) ^ x;
}

float u32_to_unit_float(uint x)
{
	// Map uint32 → [0, 1). 1/2^32 ≈ 2.328306e-10.
	return float(x) * 2.3283064e-10;
}

[numthreads(64, 1, 1)]
void FSDSLidarDecodeCS(uint3 DTid : SV_DispatchThreadID)
{
	const uint RayIdx = DTid.x;
	const uint TotalRays = NumChannels * NumHorizontalSteps;
	if (RayIdx >= TotalRays) return;

	// Default to invalid; bail-outs below leave this in place. The
	// w channel carries intensity in [0,1] for valid hits or -1.0 as
	// the invalid sentinel — distinct from a clean 0.0 intensity (a
	// black surface at grazing angle is a valid hit with intensity 0).
	OutPoints[RayIdx] = float4(0.0, 0.0, 0.0, -1.0);

	// Buffer ordering: match the CPU path's flat-index convention so
	// that PointCloud2 consumers receive points in the same memory
	// order under both backends. CPU uses SlotIdx = h*NumChannels + v
	// (h slow, v fast), so adjacent buffer entries trace a radial
	// line of increasing v at the same h.
	const uint HIdx = RayIdx / NumChannels;
	const uint VIdx = RayIdx % NumChannels;

	// Spherical (h, v) for this LiDAR ray. Uniform azimuth steps; the
	// elevation comes from the per-channel table (the uniform grid when
	// settings.json gives none), same as the CPU path.
	const float HStepRad = (NumHorizontalSteps > 1)
		? (HorizontalFOVEndRad - HorizontalFOVStartRad) / float(NumHorizontalSteps)
		: 0.0;

	const float HRad = HorizontalFOVStartRad + float(HIdx) * HStepRad;
	const float VRad = ChannelElevationRad[VIdx];

	const float CosV = cos(VRad);
	const float SinV = sin(VRad);
	const float CosH = cos(HRad);
	const float SinH = sin(HRad);

	// Image-plane projection. With tilt=0 (camera looks straight
	// ahead in vehicle frame) the formulas decouple to the standard
	// rectified-camera form. TiltRad is kept in the uniform buffer
	// for forward compatibility with a future asymmetric-projection
	// configuration; the C++ side currently always sets it to zero.
	const float ImageX = SinH / max(CosH, 1e-6);                          // = tan(h)
	const float ImageY = SinV / max(CosV * CosH, 1e-6);                   // = tan(v) · sec(h)

	// Bail if the ray's image-plane coords fall outside the rendered
	// frustum (asymmetric V padded to symmetric per the C++ setup).
	if (ImageX < -HHalfPlanar || ImageX > HHalfPlanar) return;
	if (ImageY < VBottomPlanar || ImageY > VTopPlanar) return;

	const float TexelColF = (ImageX + HHalfPlanar) / (2.0 * HHalfPlanar) * float(RTWidth);
	// UE5 screen-space Y is *down*-positive; image_y in camera-up
	// convention is up-positive. Flip Y so a positive v-angle maps to
	// the *top* of the RT.
	const float TexelRowF = (VTopPlanar - ImageY) / (VTopPlanar - VBottomPlanar) * float(RTHeight);

	const int Col = clamp(int(TexelColF), 0, int(RTWidth)  - 1);
	const int Row = clamp(int(TexelRowF), 0, int(RTHeight) - 1);

	const float DepthZCm = DepthTexture.Load(int3(Col, Row, 0));

	// SCS_SceneDepth gives the perpendicular distance from the camera
	// plane (z-axis depth in view space). To get the radial distance
	// along the LiDAR ray, divide by cos(angle between ray and camera
	// forward). With tilt=0 and forward = (1, 0, 0) in vehicle frame:
	//   cos(α) = d · (1,0,0) = cos(v) · cos(h)
	const float CosAlpha = max(CosV * CosH, 1e-6);
	float RayDistCm = DepthZCm / CosAlpha;

	// Per-channel range envelope. Real LiDARs (Hesai datasheet App.
	// A.1.1) have per-beam laser-power variance — outer beams reach
	// less far than the central ones. Read the channel's max range
	// from the per-channel uniform; the C++ side guarantees this
	// buffer is always NumChannels long (falls back to the global
	// MaxRange when no per-channel override is configured).
	//
	// First cull is pre-noise — equivalent to the CPU path's trace
	// endpoint being clipped at ChannelMaxR before the LineTrace.
	// Without it the depth RT (rendered out to the global MaxRange)
	// would feed in hits that are physically out of the beam's reach
	// and waste a dropout/noise RNG sample on them.
	const float ChannelMaxR = ChannelMaxRangeCm[VIdx];
	if (RayDistCm > ChannelMaxR) return;

	// Reconstruct 3D point along the spherical ray. Direction from
	// (h, v) in vehicle frame using the same Tait-Bryan ordering as
	// the CPU path's FRotator(VAngle, HAngle, 0).Vector():
	//   forward = +X, right = +Y, up = +Z
	//   → (cos(v)·cos(h), cos(v)·sin(h), sin(v))
	const float DirX = CosV * CosH;
	const float DirY = CosV * SinH;
	const float DirZ = SinV;

	// Reflectance and incidence come before the noise: the range noise
	// depends on the reflectance, and the edge model on the neighbour depths.
	// === Intensity (#255 / #321 / #358). Hesai-class working principle:
	//   intensity = ρ × cos(θ_inc) × (R_ref / range)²
	// where ρ is the surface reflectance, θ_inc is the angle of
	// incidence between the ray and the surface normal at the hit,
	// and the inverse-square term is normalised so a perpendicular
	// surface at R_ref returns the unmodified reflectance.
	//
	// `UseReflectanceLUT == 0`: legacy luminance-only path. ColorTexture
	// is the raw FinalColorLDR; ρ ≈ Rec.709 luminance(rgb). Used pre-
	// Phase-2 deployments where M_LiDARStencilEncoder isn't loaded.
	//
	// `UseReflectanceLUT == 1`: Phase-2 path. The post-process material
	// (M_LiDARStencilEncoder) packs two values into ColorTexture:
	//   .r = stencil_id / 255   — cone spawner writes the stencil ID,
	//                             the post-process pipes it here
	//   .g = Rec.709 luminance(scene.rgb)  — fallback ρ, pre-computed
	//                                        in the material so the
	//                                        shader skips the dot-product
	// Stencil = 0 / out-of-range / LUT slot unset → fall back to .g.
	//
	// Branching on the uniform is essentially free (constant across
	// the whole dispatch).
	const float4 ColorSample = ColorTexture.Load(int3(Col, Row, 0));

	float Reflectance;
	if (UseReflectanceLUT > 0u)
	{
		// Phase-2 path: stencil in R, pre-computed luminance in G.
		const uint StencilID = uint(ColorSample.r * 255.0 + 0.5);
		const float LuminanceFallback = saturate(ColorSample.g);
		Reflectance = LuminanceFallback;
		if (StencilID > 0u && StencilID < 16u)
		{
			const float LookupRho = GET_SCALAR_ARRAY_ELEMENT(ReflectanceLUT, StencilID);
			if (LookupRho > 0.0)
			{
				Reflectance = LookupRho;
			}
		}
	}
	else
	{
		// Legacy path: raw FinalColorLDR, compute Rec.709 in shader.
		Reflectance = saturate(dot(ColorSample.rgb, float3(0.2126, 0.7152, 0.0722)));
	}

	// Surface normal from depth gradient. We don't have a populated
	// SCS_Normal RT (Mac UE5 5.7's forward path doesn't fill it), but
	// the depth RT we already have is enough: the central-difference
	// gradient of depth across neighbouring texels gives the local
	// surface tangents in image space, which we cross to get the
	// surface normal in *view* space, then rotate to world via the
	// sensor's row vectors. Output is unit-length in world frame.
	const int CL = max(Col - 1, 0);
	const int CR = min(Col + 1, int(RTWidth) - 1);
	const int RU = max(Row - 1, 0);
	const int RD = min(Row + 1, int(RTHeight) - 1);
	const float DLeft  = DepthTexture.Load(int3(CL,  Row, 0));
	const float DRight = DepthTexture.Load(int3(CR,  Row, 0));
	const float DUp    = DepthTexture.Load(int3(Col, RU,  0));
	const float DDown  = DepthTexture.Load(int3(Col, RD,  0));
	// View-space tangent vectors. dx_view = (texel_size_x_world,
	// 0, dz/dx_pixel). Texel-to-world scale cancels out when we
	// normalise so we can use the depth gradient directly with unit
	// pixel deltas.
	const float3 TangentX_View = float3(2.0, 0.0,           DRight - DLeft);
	const float3 TangentY_View = float3(0.0, 2.0,           DDown  - DUp);
	const float3 NormalView    = normalize(cross(TangentY_View, TangentX_View));

	// Sensor's view space → vehicle frame: the SceneCapture looks
	// along +X (vehicle forward), with +Y_view = right_image and
	// +Z_view = into_screen. Convert to vehicle-frame coords:
	//   normal_vehicle.x =  NormalView.z   (toward sensor → into screen)
	//   normal_vehicle.y = -NormalView.x   (UE Y-right → vehicle Y-right; depth-grad +x_image points right)
	//   normal_vehicle.z = -NormalView.y   (image Y is down-positive; vehicle Z is up)
	const float3 NormalVehicle = float3( NormalView.z, -NormalView.x, -NormalView.y);

	// Vehicle frame → world frame via the sensor's pre-packed rotation rows.
	const float3 NormalWorld = float3(
		dot(SensorRotRowX, NormalVehicle),
		dot(SensorRotRowY, NormalVehicle),
		dot(SensorRotRowZ, NormalVehicle));

	// Ray direction in world frame.
	const float3 DirVehicle = float3(DirX, DirY, DirZ);
	const float3 DirWorld   = float3(
		dot(SensorRotRowX, DirVehicle),
		dot(SensorRotRowY, DirVehicle),
		dot(SensorRotRowZ, DirVehicle));
	const float CosIncidence = saturate(dot(-DirWorld, NormalWorld));

	// Per-ray RNG seed combines a per-scan seed (CPU side) with the
	// ray index so each ray gets a distinct deterministic stream.
	uint RNGState = pcg_hash(RayIdx ^ RNGSeed);

	// Dropout — reject this hit with probability DropoutRate.
	if (DropoutRate > 0.0)
	{
		RNGState = pcg_hash(RNGState);
		const float r = u32_to_unit_float(RNGState);
		if (r < DropoutRate) return;
	}

	// Range noise (σ in cm), measured on the car's Hesai (manual bag
	// 2026-09-20, parked, matched ring x 0.1° azimuth cells):
	//   σ(r, ρ) = (RangeNoiseStdCm + RangeNoiseRangeCoeffCm · r_m²)
	//             · (RangeNoiseRefReflectance / ρ)^RangeNoiseReflectanceExp
	// ~1.5 cm at 5-10 m, ~1.9 cm at 10-15 m, 4-7 cm beyond 15 m; dark
	// returns are noisier (σ ∝ ρ^-0.8: 4.5 cm at reflectivity ~5 %, 0.7 cm
	// at ~45 %). The reflectance term uses the material ρ, not ρ·cos θ: the
	// car's intensity is calibrated reflectivity, flat with incidence.
	// With the extra coefficients at 0 this is the old flat Gaussian.
	RNGState = pcg_hash(RNGState);
	const float NoiseU1 = max(u32_to_unit_float(RNGState), 1e-7);
	RNGState = pcg_hash(RNGState);
	const float NoiseU2 = u32_to_unit_float(RNGState);
	const float NoiseRadius = sqrt(-2.0 * log(NoiseU1));
	const float GaussRange = NoiseRadius * cos(6.2831853 * NoiseU2);
	const float GaussIntensity = NoiseRadius * sin(6.2831853 * NoiseU2);  // the Box-Muller pair's second, independent sample
	{
		const float RangeMPreNoise = RayDistCm / 100.0;
		float SigmaCm = RangeNoiseStdCm + RangeNoiseRangeCoeffCm * RangeMPreNoise * RangeMPreNoise;
		if (RangeNoiseReflectanceExp > 0.0)
		{
			const float RhoFactor = pow(RangeNoiseRefReflectance / max(Reflectance, 0.02), RangeNoiseReflectanceExp);
			SigmaCm *= clamp(RhoFactor, 0.3, 4.0);
		}
		RayDistCm += SigmaCm * GaussRange;
	}

	// Mixed returns at silhouettes: where a neighbouring texel's depth
	// jumps by more than 30 cm (a cone edge against the background), the
	// car's returns sometimes land between the two surfaces. With
	// probability EdgeOutlierRate, place the return uniformly between this
	// hit and the farthest neighbour. The car shows such >30 cm jumps on
	// ~2 % of object returns at 5-10 m.
	if (EdgeOutlierRate > 0.0)
	{
		const float DFar = max(max(DLeft, DRight), max(DUp, DDown));
		if (DFar - DepthZCm > 30.0)
		{
			RNGState = pcg_hash(RNGState);
			if (u32_to_unit_float(RNGState) < EdgeOutlierRate)
			{
				RNGState = pcg_hash(RNGState);
				const float Mix = u32_to_unit_float(RNGState);
				RayDistCm = lerp(RayDistCm, DFar / CosAlpha, Mix);
			}
		}
	}

	// Re-check both bounds *after* noise — mirrors the CPU path's
	// post-noise `if (Dist < MinRange || Dist > ChannelMaxR) continue;`
	// (FSDSLidarSensor.cpp PerformScan). Without the upper re-check, a
	// hit that lands just under ChannelMaxR pre-noise but gets pushed
	// past it by +noise would survive on GPU and be dropped on CPU —
	// the boundary divergence flagged by audit issue #231.
	if (RayDistCm < MinRangeCm || RayDistCm > ChannelMaxR) return;

	// Reconstruct in vehicle-local frame: sensor-relative endpoint
	// plus the sensor mount offset (in metres). The CPU path gets
	// this for free via OwnerTransform.InverseTransformPosition;
	// here we have to add it explicitly because the shader works in
	// the sensor's local frame.
	const float ScaleM = RayDistCm / 100.0;
	const float3 DirSensor = float3(DirX, DirY, DirZ);
	const float Px = dot(MountRotRowX, DirSensor) * ScaleM + SensorOffsetXm;
	const float Py = dot(MountRotRowY, DirSensor) * ScaleM + SensorOffsetYm;
	const float Pz = dot(MountRotRowZ, DirSensor) * ScaleM + SensorOffsetZm;

	const float RangeM   = max(ScaleM, 0.01);  // floor at 1 cm so the inverse-square doesn't blow up at point-blank
	const float RangeRef = max(RReferenceM, 1e-3);
	const float Falloff  = (RangeRef * RangeRef) / (RangeM * RangeM);
	// Scan-to-scan intensity jitter, relative (car: ~14 %).
	const float Intensity = saturate(Reflectance * CosIncidence * Falloff
		* max(0.0, 1.0 + IntensityNoiseRel * GaussIntensity));

	// cm → m + ROS REP-103 Y-flip (UE Y-right → ROS Y-left). The w
	// channel carries intensity for valid hits ([0, 1]); -1.0 sentinel
	// for invalid was written above and any return-path bail leaves it.
	// Debug (fsds.LidarGPU.DebugColorChannel): 2 = report the colour
	// capture's raw R (the encoded stencil ID, x255), 3 = raw G (the
	// luminance fallback), instead of the intensity.
	const float OutIntensity = UseReflectanceLUT == 2u ? ColorSample.r
		: (UseReflectanceLUT == 3u ? ColorSample.g : Intensity);
	OutPoints[RayIdx] = float4(Px, -Py, Pz, OutIntensity);
}
