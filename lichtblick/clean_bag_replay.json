  "globalVariables": {},
  "userNodes": {
    "map_to_odom_norm": {
      "name": "map_to_odom_norm",
      "sourceCode": "// Compute ||map \u2192 odom|| translation magnitude from /tf.\n//\n// `map \u2192 odom` is SLAM's drift-correction transform: how far it has had\n// to drag the odom frame to keep dead-reckoning agreeing with the cone\n// map. Magnitude grows whenever OdometryFilter accumulates error\n// faster than per-scan SLAM corrections can absorb. A healthy lap\n// stays sub-metre; tens of metres means dead-reckoning is the\n// upstream problem (#391 \u2014 vy contamination, gyro bias).\n//\n// Output: /studio_script/map_to_odom_norm (m, Float32-shaped).\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nexport const inputs = [\"/tf\"];\nexport const output = \"/studio_script/map_to_odom_norm\";\n\nexport default function node(\n  event: Input<\"/tf\">,\n): Output | undefined {\n  for (const t of event.message.transforms) {\n    if (t.header.frame_id === \"map\" && t.child_frame_id === \"odom\") {\n      const tx = t.transform.translation.x;\n      const ty = t.transform.translation.y;\n      // 2D vehicle \u2014 z translation is essentially zero, omit it from\n      // the norm so the plot reads as planar drift.\n      return { data: Math.hypot(tx, ty) };\n    }\n  }\n  return undefined;\n}\n"
    }
  },
