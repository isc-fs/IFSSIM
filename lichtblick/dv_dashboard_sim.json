  "userNodes": {
    "gg_in_g": {
      "name": "gg_in_g",
      "sourceCode": "import { Input } from \"./types\";\n\nexport const inputs = [\"/imu\"];\nexport const output = \"/gg_g\";\n\n// Republish IMU linear acceleration in g (1 g = 9.81 m/s^2) so the\n// G-G plot can show lateral/longitudinal load directly in g.\nexport default function (event: Input<\"/imu\">): { ax_g: number; ay_g: number } {\n  const G = 9.81;\n  return {\n    ax_g: event.message.linear_acceleration.x / G,\n    ay_g: event.message.linear_acceleration.y / G,\n  };\n}\n"
    },
    "path_error": {
      "name": "path_error",
      "sourceCode": "import { Input } from \"./types\";\n\ntype Output = { lateral_deviation_m: number };\nexport const inputs = [\"/slam/pose\", \"/Path\"];\nexport const output = \"/path_error\";\n\n// Cached path polyline (map frame). Refreshed whenever /Path arrives.\nlet pathPts: { x: number; y: number }[] = [];\n\n// Signed perpendicular distance from the SLAM pose to the nearest /Path\n// segment. Both topics are in the map frame, so a plain 2D projection\n// works. Sign: + = car is left of the path direction, - = right.\nexport default function (\n  event: Input<\"/slam/pose\"> | Input<\"/Path\">,\n): Output | undefined {\n  if (event.topic === \"/Path\") {\n    pathPts = event.message.poses.map((p) => ({\n      x: p.pose.position.x,\n      y: p.pose.position.y,\n    }));\n    return undefined;\n  }\n  if (pathPts.length < 2) return undefined;\n  const p = event.message.pose.pose.position;\n  let bestD = Infinity;\n  let bestSigned = 0;\n  for (let i = 0; i < pathPts.length - 1; i++) {\n    const a = pathPts[i];\n    const b = pathPts[i + 1];\n    const abx = b.x - a.x, aby = b.y - a.y;\n    const apx = p.x - a.x, apy = p.y - a.y;\n    const len2 = abx * abx + aby * aby;\n    let t = len2 > 0 ? (apx * abx + apy * aby) / len2 : 0;\n    t = Math.max(0, Math.min(1, t));\n    const dx = apx - t * abx, dy = apy - t * aby;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n    if (dist < bestD) {\n      bestD = dist;\n      const cross = abx * apy - aby * apx; // + = left of path direction\n      bestSigned = cross >= 0 ? dist : -dist;\n    }\n  }\n  return { lateral_deviation_m: bestSigned };\n}\n"
    },
    "state_labels": {
      "name": "state_labels",
      "sourceCode": "import { Input } from \"./types\";\n\ntype In =\n  | Input<\"/assi/state\"> | Input<\"/dv/status\"> | Input<\"/ami/mission\">\n  | Input<\"/ctrl/emergency\"> | Input<\"/slam/finished\">;\n\ntype Labels = { assi: string; dv: string; ami: string; emergency: string; finished: string };\n\nexport const inputs = [\"/assi/state\", \"/dv/status\", \"/ami/mission\",\n  \"/ctrl/emergency\", \"/slam/finished\"];\nexport const output = \"/state_labels\";\n\nconst st = { assi: -1, dv: -1, ami: -1, emergency: false, finished: false };\n\nconst ASSI = [\"OFF\", \"EMERGENCY\", \"READY\", \"DRIVING\", \"FINISHED\"];\nconst DV = [\"IDLE\", \"PREPARING\", \"READY\", \"RUNNING\", \"FINISHED\", \"EMERGENCY\", \"FAILED\"];\nconst AMI = [\"Manual\", \"Acceleration\", \"Skidpad\", \"Autocross\", \"Trackdrive\",\n  \"EVS/EBS\", \"Inspection\", \"Shutdown\", \"Aux1\", \"Aux2\"];\n\nfunction pick(a: string[], i: number): string {\n  return i >= 0 && i < a.length ? a[i] : \"?\" + i;\n}\n\nexport default function (event: In): Labels {\n  switch (event.topic) {\n    case \"/assi/state\": st.assi = event.message.data; break;\n    case \"/dv/status\": st.dv = event.message.data; break;\n    case \"/ami/mission\": st.ami = event.message.data; break;\n    case \"/ctrl/emergency\": st.emergency = event.message.data; break;\n    case \"/slam/finished\": st.finished = event.message.data; break;\n  }\n  return {\n    assi: pick(ASSI, st.assi),\n    dv: pick(DV, st.dv),\n    ami: pick(AMI, st.ami),\n    emergency: st.emergency ? \"EBS REQUESTED\" : \"nominal\",\n    finished: st.finished ? \"FINISHED\" : \"running\",\n  };\n}\n"
    }
  },
