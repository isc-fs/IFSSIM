  "userNodes": {
    "limoncello_gt_separation": {
      "name": "limoncello_gt_separation",
      "sourceCode": "// Per-tick raw separation between LIMOncello's pose and the GT pose.\n//\n// IMPORTANT: this is the absolute-frame distance with NO alignment\n// applied. LIMOncello bootstraps its `map` frame from the IMU's\n// initial orientation (gravity-aligned, but yaw is arbitrary), while\n// /testing_only/odom uses the sim's world frame. They almost always\n// differ by a yaw + translation offset, which inflates this number\n// regardless of how well LIMOncello is actually tracking. Use\n// tools/limoncello/compare-pose-rmse.py for the SE(2)-aligned RMSE\n// that's the real signal.\n//\n// What this plot IS useful for: spotting sudden jumps in the\n// separation (cascade detonations, lost-track events), and\n// confirming the trend (growing = drift accumulating, flat =\n// LIMOncello holding the same relative offset from GT).\n//\n// Subscribes to /limoncello/state; holds the latest /testing_only/odom\n// in node-local state. Emits /studio_script/limoncello_gt_separation\n// (Float32-shaped) on every LIMOncello sample.\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nexport const inputs = [\"/limoncello/state\", \"/testing_only/odom\"];\nexport const output = \"/studio_script/limoncello_gt_separation\";\n\n// Module-level state: last GT pose seen. Persists across script\n// invocations because Lichtblick re-uses the same module instance\n// for each tick.\nlet lastGtX: number | undefined;\nlet lastGtY: number | undefined;\n\nexport default function script(\n  event:\n    | Input<\"/limoncello/state\">\n    | Input<\"/testing_only/odom\">,\n): Output | undefined {\n  // Cache the most recent GT pose. We don't emit on GT samples\n  // because LIMOncello is the higher-rate stream (~315 Hz vs ~80 Hz)\n  // and we want one separation reading per LIMOncello pose.\n  if (event.topic === \"/testing_only/odom\") {\n    lastGtX = event.message.pose.pose.position.x;\n    lastGtY = event.message.pose.pose.position.y;\n    return undefined;\n  }\n\n  // Skip until we've seen at least one GT sample.\n  if (lastGtX === undefined || lastGtY === undefined) {\n    return undefined;\n  }\n\n  const lx = event.message.pose.pose.position.x;\n  const ly = event.message.pose.pose.position.y;\n  const dx = lx - lastGtX;\n  const dy = ly - lastGtY;\n  return { data: Math.sqrt(dx * dx + dy * dy) };\n}\n"
    }
  },
