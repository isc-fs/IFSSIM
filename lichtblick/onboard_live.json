  "globalVariables": {},
  "userNodes": {
    "perc_detected_count": {
      "name": "perc_detected_count",
      "sourceCode": "// Per-scan cone count from /Conos_raw (skips the DELETEALL leader).\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nconst ADD = 0;\n\nexport const inputs = [\"/Conos_raw\"];\nexport const output = \"/studio_script/perc_detected_count\";\n\nexport default function node(\n  event: Input<\"/Conos_raw\">,\n): Output | undefined {\n  let n = 0;\n  for (const m of event.message.markers) {\n    if (m.action === ADD) n++;\n  }\n  return { data: n };\n}\n"
    },
    "perc_orange_count": {
      "name": "perc_orange_count",
      "sourceCode": "// Big-orange cone count from /Conos_Orange.\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nconst ADD = 0;\n\nexport const inputs = [\"/Conos_Orange\"];\nexport const output = \"/studio_script/perc_orange_count\";\n\nexport default function node(\n  event: Input<\"/Conos_Orange\">,\n): Output | undefined {\n  let n = 0;\n  for (const m of event.message.markers) {\n    if (m.action === ADD) n++;\n  }\n  return { data: n };\n}\n"
    },
    "recon_paths": {
      "name": "recon_paths",
      "sourceCode": "// SLAM (blue) and EKF /odom (red) trails in the map frame.\n// /slam/pose is map-frame. /odom is odom-frame; raw XY in map shows\n// dead-reckoning vs the cone map (they split by ||map→odom||).\n// Trails clear on stamp rewind (replay loop) or a >10 m teleport.\n\nimport { Input } from \"./types\";\n\ntype Point = { x: number; y: number; z: number };\ntype RGBA = { r: number; g: number; b: number; a: number };\ntype Marker = {\n  header: { frame_id: string; stamp: { sec: number; nsec: number } };\n  ns: string; id: number; type: number; action: number;\n  pose: { position: Point; orientation: { x: number; y: number; z: number; w: number } };\n  scale: Point; color: RGBA; points: Point[];\n};\ntype MarkerArray = { markers: Marker[] };\n\nconst LINE_STRIP = 4;\nconst ADD = 0;\nconst MAX_PTS = 6000;\nconst STAMP_REWIND_S = 0.5;\nconst TELEPORT_M = 10.0;\n\nexport const inputs = [\"/slam/pose\", \"/odom\"];\nexport const output = \"/studio_script/recon_paths\";\n\nconst slamPts: Point[] = [];\nconst ekfPts: Point[] = [];\nconst lastPos: { [topic: string]: Point } = {};\nlet maxStamp = -1;\nlet lastStamp = { sec: 0, nsec: 0 };\n\nfunction toSec(s: { sec: number; nsec: number }): number {\n  return s.sec + s.nsec * 1e-9;\n}\n\nfunction clearAll(): void {\n  slamPts.length = 0;\n  ekfPts.length = 0;\n  for (const k of Object.keys(lastPos)) delete lastPos[k];\n}\n\nfunction push(arr: Point[], p: Point): void {\n  arr.push({ x: p.x, y: p.y, z: 0.05 });\n  if (arr.length > MAX_PTS) arr.shift();\n}\n\nfunction line(id: number, pts: Point[], color: RGBA): Marker {\n  return {\n    header: { frame_id: \"map\", stamp: lastStamp },\n    ns: \"recon_paths\", id, type: LINE_STRIP, action: ADD,\n    pose: { position: { x: 0, y: 0, z: 0 }, orientation: { x: 0, y: 0, z: 0, w: 1 } },\n    scale: { x: 0.15, y: 0, z: 0 },\n    color, points: pts.map((q) => ({ x: q.x, y: q.y, z: q.z })),\n  };\n}\n\nexport default function node(\n  event: Input<\"/slam/pose\"> | Input<\"/odom\">,\n): MarkerArray | undefined {\n  const stamp = event.message.header.stamp;\n  const t = toSec(stamp);\n  const p = event.message.pose.pose.position;\n  if (maxStamp >= 0 && t < maxStamp - STAMP_REWIND_S) clearAll();\n  if (t > maxStamp) maxStamp = t;\n  const prev = lastPos[event.topic];\n  if (prev !== undefined && Math.hypot(p.x - prev.x, p.y - prev.y) > TELEPORT_M) {\n    clearAll();\n  }\n  lastPos[event.topic] = { x: p.x, y: p.y, z: 0 };\n  lastStamp = stamp;\n  if (event.topic === \"/slam/pose\") push(slamPts, p);\n  else push(ekfPts, p);\n  const markers: Marker[] = [];\n  if (slamPts.length > 1) markers.push(line(0, slamPts, { r: 0.27, g: 0.53, b: 1.0, a: 0.95 }));\n  if (ekfPts.length > 1) markers.push(line(1, ekfPts, { r: 1.0, g: 0.27, b: 0.27, a: 0.95 }));\n  return { markers };\n}\n"
    },
    "map_to_odom_norm": {
      "name": "map_to_odom_norm",
      "sourceCode": "// ||map → odom|| translation from /tf (SLAM drift correction).\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nexport const inputs = [\"/tf\"];\nexport const output = \"/studio_script/map_to_odom_norm\";\n\nexport default function node(event: Input<\"/tf\">): Output | undefined {\n  for (const t of event.message.transforms) {\n    if (t.header.frame_id === \"map\" && t.child_frame_id === \"odom\") {\n      const tx = t.transform.translation.x;\n      const ty = t.transform.translation.y;\n      return { data: Math.hypot(tx, ty) };\n    }\n  }\n  return undefined;\n}\n"
    },
    "slam_odom_gap": {
      "name": "slam_odom_gap",
      "sourceCode": "// ||SLAM XY − odom XY||. Frames differ by map→odom; a growing gap with a\n// flat ||map→odom|| means the two estimators are walking apart in place.\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\ntype Pose = { pose: { pose: { position: { x: number; y: number } } } };\n\nexport const inputs = [\"/slam/pose\", \"/odom\"];\nexport const output = \"/studio_script/slam_odom_gap\";\n\nlet slam: Pose | undefined;\nlet odom: Pose | undefined;\n\nexport default function node(\n  event: Input<\"/slam/pose\"> | Input<\"/odom\">,\n): Output | undefined {\n  if (event.topic === \"/slam/pose\") slam = event.message;\n  else odom = event.message;\n  if (!slam || !odom) return undefined;\n  const dx = slam.pose.pose.position.x - odom.pose.pose.position.x;\n  const dy = slam.pose.pose.position.y - odom.pose.pose.position.y;\n  return { data: Math.hypot(dx, dy) };\n}\n"
    }
  },
  "playbackConfig": {
    "speed": 1
  },
  "layout": "Tab!main"
}
