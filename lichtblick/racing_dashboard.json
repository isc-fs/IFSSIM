  "userNodes": {
    "gt_cones_body": {
      "name": "gt_cones_body",
      "sourceCode": "// GT cones transformed into base_link for BEV perception debug.\n// Blue cubes = sim ground truth; compare against magenta /Conos_raw.\n// Matches benchmark GT gate: 0.5–20 m radial, ±60° H-FOV (sim LiDAR MinRange + perception).\n\nimport { Input } from \"./types\";\n\ntype Marker = {\n  header: { frame_id: string; stamp: { sec: number; nsec: number } };\n  ns: string;\n  id: number;\n  type: number;\n  action: number;\n  pose: {\n    position: { x: number; y: number; z: number };\n    orientation: { x: number; y: number; z: number; w: number };\n  };\n  scale: { x: number; y: number; z: number };\n  color: { r: number; g: number; b: number; a: number };\n};\n\ntype MarkerArray = { markers: Marker[] };\n\nconst MIN_RANGE_M = 0.5;\nconst RANGE_M = 20.0;\nconst HFOV_HALF_DEG = 60.0;\nconst CUBE = 1;\nconst DELETEALL = 3;\nconst ADD = 0;\n\nlet latestTrack:\n  | { track: Array<{ location: { x: number; y: number; z: number } }> }\n  | undefined;\nlet latestOdom:\n  | {\n      header: { stamp: { sec: number; nsec: number } };\n      pose: {\n        pose: {\n          position: { x: number; y: number };\n          orientation: { w: number; x: number; y: number; z: number };\n        };\n      };\n    }\n  | undefined;\n\nfunction quatYaw(q: { w: number; x: number; y: number; z: number }): number {\n  return Math.atan2(\n    2 * (q.w * q.z + q.x * q.y),\n    1 - 2 * (q.y * q.y + q.z * q.z),\n  );\n}\n\nfunction build(): MarkerArray | undefined {\n  if (!latestTrack || !latestOdom) return undefined;\n  const odom = latestOdom;\n  const ox = odom.pose.pose.position.x;\n  const oy = odom.pose.pose.position.y;\n  const yaw = quatYaw(odom.pose.pose.orientation);\n  const cosY = Math.cos(yaw);\n  const sinY = Math.sin(yaw);\n  const stamp = odom.header.stamp;\n  const markers: Marker[] = [];\n  let id = 0;\n  markers.push({\n    header: { frame_id: \"base_link\", stamp },\n    ns: \"gt\",\n    id: id++,\n    type: CUBE,\n    action: DELETEALL,\n    pose: {\n      position: { x: 0, y: 0, z: 0 },\n      orientation: { x: 0, y: 0, z: 0, w: 1 },\n    },\n    scale: { x: 0.01, y: 0.01, z: 0.01 },\n    color: { r: 0, g: 0, b: 0, a: 0 },\n  });\n  for (const cone of latestTrack.track) {\n    const dx = cone.location.x - ox;\n    const dy = cone.location.y - oy;\n    const x = cosY * dx + sinY * dy;\n    const y = -sinY * dx + cosY * dy;\n    const r = Math.hypot(x, y);\n    if (r < MIN_RANGE_M || r > RANGE_M) continue;\n    if (x <= 0) continue;\n    if (Math.abs(Math.atan2(y, x)) > (HFOV_HALF_DEG * Math.PI) / 180) continue;\n    markers.push({\n      header: { frame_id: \"base_link\", stamp },\n      ns: \"gt\",\n      id: id++,\n      type: CUBE,\n      action: ADD,\n      pose: {\n        position: { x, y, z: 0.15 },\n        orientation: { x: 0, y: 0, z: 0, w: 1 },\n      },\n      scale: { x: 0.24, y: 0.24, z: 0.35 },\n      color: { r: 0.15, g: 0.55, b: 1.0, a: 0.85 },\n    });\n  }\n  return { markers };\n}\n\nexport const inputs = [\"/testing_only/track\", \"/testing_only/odom\"];\nexport const output = \"/studio_script/gt_cones_body\";\n\nexport default function node(\n  event: Input<\"/testing_only/track\"> | Input<\"/testing_only/odom\">,\n): MarkerArray | undefined {\n  if (event.topic === \"/testing_only/track\") {\n    latestTrack = event.message;\n  } else {\n    latestOdom = event.message;\n  }\n  return build();\n}\n"
    },
    "gt_cones_odom": {
      "name": "gt_cones_odom",
      "sourceCode": "// Full GT track in odom/world frame (all cones, not range-gated).\n\nimport { Input } from \"./types\";\n\ntype Marker = {\n  header: { frame_id: string; stamp: { sec: number; nsec: number } };\n  ns: string;\n  id: number;\n  type: number;\n  action: number;\n  pose: {\n    position: { x: number; y: number; z: number };\n    orientation: { x: number; y: number; z: number; w: number };\n  };\n  scale: { x: number; y: number; z: number };\n  color: { r: number; g: number; b: number; a: number };\n};\n\ntype MarkerArray = { markers: Marker[] };\n\nconst CUBE = 1;\nconst DELETEALL = 3;\nconst ADD = 0;\n\nfunction coneColor(\n  color: number,\n): { r: number; g: number; b: number; a: number } {\n  if (color === 0) return { r: 1.0, g: 0.85, b: 0.0, a: 0.9 };\n  if (color === 1) return { r: 0.2, g: 0.45, b: 1.0, a: 0.9 };\n  if (color === 2) return { r: 1.0, g: 0.45, b: 0.0, a: 0.9 };\n  return { r: 0.7, g: 0.7, b: 0.7, a: 0.7 };\n}\n\nexport const inputs = [\"/testing_only/track\"];\nexport const output = \"/studio_script/gt_cones_odom\";\n\nexport default function node(\n  event: Input<\"/testing_only/track\">,\n): MarkerArray | undefined {\n  const track = event.message;\n  const stamp = event.receiveTime;\n  const markers: Marker[] = [];\n  let id = 0;\n  markers.push({\n    header: { frame_id: \"odom\", stamp },\n    ns: \"gt_track\",\n    id: id++,\n    type: CUBE,\n    action: DELETEALL,\n    pose: {\n      position: { x: 0, y: 0, z: 0 },\n      orientation: { x: 0, y: 0, z: 0, w: 1 },\n    },\n    scale: { x: 0.01, y: 0.01, z: 0.01 },\n    color: { r: 0, g: 0, b: 0, a: 0 },\n  });\n  for (const cone of track.track) {\n    const c = coneColor(cone.color);\n    markers.push({\n      header: { frame_id: \"odom\", stamp },\n      ns: \"gt_track\",\n      id: id++,\n      type: CUBE,\n      action: ADD,\n      pose: {\n        position: {\n          x: cone.location.x,\n          y: cone.location.y,\n          z: cone.location.z,\n        },\n        orientation: { x: 0, y: 0, z: 0, w: 1 },\n      },\n      scale: { x: 0.24, y: 0.24, z: 0.35 },\n      color: c,\n    });\n  }\n  return { markers };\n}\n"
    },
    "gt_cone_count_fov": {
      "name": "gt_cone_count_fov",
      "sourceCode": "// GT cone count in LiDAR-visible zone (0.5–20 m, ±60° H-FOV).\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nconst MIN_RANGE_M = 0.5;\nconst RANGE_M = 20.0;\nconst HFOV_HALF_DEG = 60.0;\n\nlet latestTrack:\n  | { track: Array<{ location: { x: number; y: number } }> }\n  | undefined;\nlet latestOdom:\n  | {\n      pose: {\n        pose: {\n          position: { x: number; y: number };\n          orientation: { w: number; x: number; y: number; z: number };\n        };\n      };\n    }\n  | undefined;\n\nfunction quatYaw(q: { w: number; x: number; y: number; z: number }): number {\n  return Math.atan2(\n    2 * (q.w * q.z + q.x * q.y),\n    1 - 2 * (q.y * q.y + q.z * q.z),\n  );\n}\n\nfunction countInFov(): number | undefined {\n  if (!latestTrack || !latestOdom) return undefined;\n  const ox = latestOdom.pose.pose.position.x;\n  const oy = latestOdom.pose.pose.position.y;\n  const yaw = quatYaw(latestOdom.pose.pose.orientation);\n  const cosY = Math.cos(yaw);\n  const sinY = Math.sin(yaw);\n  let n = 0;\n  for (const cone of latestTrack.track) {\n    const dx = cone.location.x - ox;\n    const dy = cone.location.y - oy;\n    const x = cosY * dx + sinY * dy;\n    const y = -sinY * dx + cosY * dy;\n    const r = Math.hypot(x, y);\n    if (r >= MIN_RANGE_M && r <= RANGE_M && x > 0 && Math.abs(Math.atan2(y, x)) <= (HFOV_HALF_DEG * Math.PI) / 180) n++;\n  }\n  return n;\n}\n\nexport const inputs = [\"/testing_only/track\", \"/testing_only/odom\"];\nexport const output = \"/studio_script/gt_cone_count_fov\";\n\nexport default function node(\n  event: Input<\"/testing_only/track\"> | Input<\"/testing_only/odom\">,\n): Output | undefined {\n  if (event.topic === \"/testing_only/track\") {\n    latestTrack = event.message;\n  } else {\n    latestOdom = event.message;\n  }\n  const n = countInFov();\n  if (n === undefined) return undefined;\n  return { data: n };\n}\n"
    },
    "perc_detected_count": {
      "name": "perc_detected_count",
      "sourceCode": "// Per-scan cone count from /Conos_raw (excludes DELETEALL marker).\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nconst ADD = 0;\n\nexport const inputs = [\"/Conos_raw\"];\nexport const output = \"/studio_script/perc_detected_count\";\n\nexport default function node(\n  event: Input<\"/Conos_raw\">,\n): Output | undefined {\n  let n = 0;\n  for (const m of event.message.markers) {\n    if (m.action === ADD) n++;\n  }\n  return { data: n };\n}\n"
    },
    "perc_orange_count": {
      "name": "perc_orange_count",
      "sourceCode": "// Big-orange cone count from /Conos_Orange.\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nconst ADD = 0;\n\nexport const inputs = [\"/Conos_Orange\"];\nexport const output = \"/studio_script/perc_orange_count\";\n\nexport default function node(\n  event: Input<\"/Conos_Orange\">,\n): Output | undefined {\n  let n = 0;\n  for (const m of event.message.markers) {\n    if (m.action === ADD) n++;\n  }\n  return { data: n };\n}\n"
    }
  },
  "playbackConfig": { "speed": 1 },

  "layout": "Tab!main"
}
