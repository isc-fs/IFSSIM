      "showLegend": true,
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "xAxisVal": "timestamp",
      "paths": [
        {
          "value": "/cone_slam/state.pose.pose.position.x",
          "enabled": true,
          "label": "SLAM x",
          "color": "#4488ff",
          "lineSize": 1.5,
          "timestampMethod": "receiveTime",
          "showLine": true
