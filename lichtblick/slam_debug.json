        {
          "value": "/cone_slam/state.pose.pose.position.y",
          "enabled": true,
          "label": "SLAM y",
          "color": "#88ff44",
          "lineSize": 1.5,
          "timestampMethod": "receiveTime",
          "showLine": true
        },
        {
          "value": "/cone_slam/gt_aligned.pose.pose.position.x",
          "enabled": true,
          "label": "GT x (aligned)",
          "color": "#ff4488",
          "lineSize": 1.0,
          "timestampMethod": "receiveTime",
          "showLine": true
