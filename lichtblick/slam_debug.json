{
  "configById": {
    "3D!slam": {
      "cameraState": {
        "distance": 60,
        "perspective": false,
        "phi": 0,
        "target": [0, 0, 0],
        "targetOffset": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "thetaOffset": 0,
        "fovy": 45,
        "near": 0.01,
        "far": 5000
      },
      "followTf": "odom",
      "followMode": "follow-none",
      "scene": {
        "syncCamera": false,
        "transforms": {
          "showAxes": true,
          "showLabels": true,
          "axisScale": 1
        },
        "background": { "color": "#111111" }
      },
      "transforms": {},
      "topics": {
        "/fast_limo/pointcloud": {
          "visible": true,
          "colorField": "z",
          "colorMode": "colormap",
          "colorMap": "turbo",
          "minValue": -0.5,
          "maxValue": 1.5,
          "pointSize": 2,
          "pointShape": "circle",
          "decayTime": 0
        },
        "/fast_limo/deskewed": {
          "visible": false,
          "colorField": "z",
          "colorMode": "flat",
          "flatColor": { "r": 0.2, "g": 0.9, "b": 1, "a": 1 },
          "pointSize": 3,
          "pointShape": "circle",
          "decayTime": 0
        },
        "/lidar/Lidar1": {
          "visible": false,
          "colorField": "z",
          "colorMode": "colormap",
          "colorMap": "turbo",
          "pointSize": 2,
          "pointShape": "circle",
          "decayTime": 0
        },
        "/Conos_raw": { "visible": true },
        "/Conos": { "visible": true },
        "/Conos_Orange": { "visible": true },
        "/Path": { "visible": true },
        "/Track_azul": { "visible": false },
        "/Track_amarillo": { "visible": false },
        "/testing_only/track": { "visible": false },
        "/testing_only/odom": { "visible": true },
        "/fast_limo/state": { "visible": true }
      },
      "layers": []
    },

    "Plot!pose_drift": {
      "title": "Position drift (LIMO vs GT)",
      "isSynced": true,
      "legendDisplay": "floating",
      "showLegend": true,
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "xAxisVal": "timestamp",
      "paths": [
        {
          "value": "/fast_limo/state.pose.pose.position.x",
          "enabled": true,
          "label": "LIMO x",
          "color": "#4488ff",
          "lineSize": 1.5,
          "timestampMethod": "receiveTime",
          "showLine": true
        },
        {
          "value": "/fast_limo/state.pose.pose.position.y",
          "enabled": true,
          "label": "LIMO y",
          "color": "#88ff44",
          "lineSize": 1.5,
          "timestampMethod": "receiveTime",
          "showLine": true
        },
        {
          "value": "/testing_only/odom.pose.pose.position.x",
          "enabled": true,
          "label": "GT x",
          "color": "#ff4488",
          "lineSize": 1.0,
          "timestampMethod": "receiveTime",
          "showLine": true
        },
        {
          "value": "/testing_only/odom.pose.pose.position.y",
          "enabled": true,
          "label": "GT y",
          "color": "#ffaa44",
          "lineSize": 1.0,
          "timestampMethod": "receiveTime",
          "showLine": true
        }
      ],
      "sidebarDimension": 240
    },

    "Plot!yaw_drift": {
      "title": "Yaw rate (IMU vs GT odom)",
      "isSynced": true,
      "legendDisplay": "floating",
      "showLegend": true,
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "xAxisVal": "timestamp",
      "paths": [
        {
          "value": "/imu.angular_velocity.z",
          "enabled": true,
          "label": "IMU yaw rate",
          "color": "#aa44ff",
          "lineSize": 1.5,
          "timestampMethod": "receiveTime",
          "showLine": true
        },
        {
          "value": "/testing_only/odom.twist.twist.angular.z",
          "enabled": true,
          "label": "GT yaw rate",
          "color": "#44ffaa",
          "lineSize": 1.0,
          "timestampMethod": "receiveTime",
          "showLine": true
        }
      ],
      "sidebarDimension": 240
    },

    "Plot!cone_count": {
      "title": "Mapped cones",
      "isSynced": true,
      "legendDisplay": "floating",
      "showLegend": true,
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "xAxisVal": "timestamp",
      "minYValue": 0,
      "paths": [
        {
          "value": "/Conos.markers[:]{id}.id",
          "enabled": true,
          "label": "Mapped cones",
          "color": "#00cc88",
          "lineSize": 1.5,
          "timestampMethod": "receiveTime",
          "showLine": true
        }
      ],
      "sidebarDimension": 240
    },

    "RawMessages!state": {
      "topicPath": "/fast_limo/state"
    }
  },

  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },

  "layout": {
    "direction": "row",
    "first": "3D!slam",
    "second": {
      "direction": "column",
      "first": "Plot!pose_drift",
      "second": {
        "direction": "column",
        "first": "Plot!yaw_drift",
        "second": {
          "direction": "column",
          "first": "Plot!cone_count",
          "second": "RawMessages!state",
          "splitPercentage": 40
        },
        "splitPercentage": 50
      },
      "splitPercentage": 35
    },
    "splitPercentage": 65
  }
