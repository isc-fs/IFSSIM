        {
          "value": "/cone_slam/gt_aligned.pose.pose.position.y",
          "enabled": true,
          "label": "GT y (aligned)",
          "color": "#ffaa44",
          "lineSize": 1.0,
          "timestampMethod": "receiveTime",
          "showLine": true
