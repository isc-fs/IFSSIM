# Copy to .env (git-ignored) and fill in. Never commit the real one: the repo is public.

# Tailscale name of this machine, as people will type it (tailscale status / MagicDNS)
BENCH_HOSTNAME=bench.example-tailnet.ts.net

# Long random strings, e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=
MLFLOW_ADMIN_PASSWORD=
VIEWER_PASSWORD=
# the login bench-worker uploads with
WORKER_PASSWORD=
# Signs MLflow's CSRF tokens. Random, and keep it: changing it logs everyone out of the UI.
MLFLOW_SECRET_KEY=

# Where the database and the artifacts live on this machine (back this up: backup.sh)
DATA_DIR=./data

# Local ports (127.0.0.1 only); Tailscale serves the first two over HTTPS
MLFLOW_PORT=5005
VIEWER_PORT=8050
POSTGRES_PORT=5432

# Launching benchmarks (DEPLOY.md, "Launching benchmarks"). Absolute paths.
# BENCH_REPO: a clone of IFSSIM used only by bench-worker (it checks each job's commits
# out beside it); BENCH_RESULTS: where runs are written; BENCH_BAGS: the simulator bags.
BENCH_REPO=/srv/ifssim-bench/ifssim
BENCH_RESULTS=/srv/ifssim-bench/results
BENCH_BAGS=/srv/ifssim-bench/bags
# Tailscale logins that may cancel anyone's jobs (comma separated); others cancel their own
BENCH_ADMINS=
# Optional: a read-only GitHub token (fine-grained, public repositories, no permissions)
# for PR titles on the Launch page. Without it GitHub allows 60 requests an hour.
GITHUB_TOKEN=

# Keep equal to the mlflow version in tools/sim_benchmark/tracking/uv.lock
MLFLOW_VERSION=3.16.1
